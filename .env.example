# ============================================================
# MantiRenfe — variables de entorno (copia este archivo a .env)
# ============================================================

# --- Entorno ---
NODE_ENV=development

# --- Base de datos (Supabase > Project Settings > Database) ---
# Usar la cadena "Connection string > URI" (pooled) de Supabase
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres"

# --- Redis (local o Upstash/Redis cloud) ---
REDIS_URL="redis://localhost:6379"

# --- API NestJS ---
API_PORT=3000
# Orígenes permitidos (CORS) separados por comas
WEB_ORIGIN="http://localhost:5173,http://localhost:4173"

# --- Autenticación ---
# Supabase > Project Settings > API > JWT Secret (valida los access tokens de Supabase Auth)
SUPABASE_JWT_SECRET=""
# Fallback solo para desarrollo local sin Supabase
JWT_SECRET="dev-secret-cambiar-en-produccion"

# --- Supabase (lectura desde la web) ---
# Supabase > Project Settings > API > Project URL y anon public key
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# --- Fuentes de datos de trenes ---
# Fuente de disponibilidad de asientos: mock | dwr (scraping de venta.renfe.com; fragil)
FUENTE_DISPONIBILIDAD="mock"
# mock = datos de ejemplo (desarrollo) | dwr = API interna de venta Renfe (experimental, frágil)
# Las alertas con criterio RETRASO siempre usan GTFS-RT real (ignoran esta variable)
# Feeds GTFS-RT separados por comma (posiciones en tiempo real)
GTFS_RT_URLS="https://gtfsrt.renfe.com/vehicle_positions.json,https://gtfsrt.renfe.com/vehicle_positions_LD.json"
# Retrasos GTFS-RT (trip updates) — lo usan la API y las alertas con criterio RETRASO
GTFS_RT_TRIP_UPDATES_URL="https://gtfsrt.renfe.com/trip_updates.json,https://gtfsrt.renfe.com/trip_updates_LD.json"
# Feeds GTFS estáticos zip (stops/trips/stop_times/calendar)
GTFS_ZIP_URLS="https://ssl.renfe.com/gtransit/Fichero_AV_LD/google_transit.zip,https://ssl.renfe.com/ftransit/Fichero_CER_FOMENTO/fomento_transit.zip"
# Días a materializar en horarioTren (hoy + N días)
GTFS_DIAS_VENTANA="45"
# Umbral de retraso para avisos (segundos)
RETRASO_UMBRAL_SEG="300"

# --- Observabilidad ---
SENTRY_DSN=""

# --- Mobile (Expo) — EXPO_PUBLIC_* se expone al bundle del cliente ---
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
# Segundos de cach� compartida por ruta+fecha para la fuente DWR (evita repetir consultas a Renfe)
DWR_CACHE_SEG="120"

# Rol restringido (solo DML) que usa la app en runtime. Migraciones (prisma db push) usan DATABASE_URL (postgres).
# Forma del pooler Supabase para roles custom: usuario = <rol>.<project-ref>
# DATABASE_URL_APP="postgresql://mantirenfe_app.<project-ref>:<password>@<pooler>:5432/postgres"
# Segundos de cach� de posiciones GTFS-RT en la API (el feed se actualiza cada 15-30 s)
POSICIONES_CACHE_SEG="30"
# URL del proyecto Supabase (la API la usa para verificar tokens via JWKS)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
