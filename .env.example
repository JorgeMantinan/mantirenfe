# ============================================================
# MantiRenfe — variables de entorno (copia este archivo a .env)
# ============================================================

# --- Entorno ---
NODE_ENV=development

# --- Base de datos (Supabase > Project Settings > Database) ---
# Usar la cadena "Connection string > URI" (pooled) de Supabase
DATABASE_URL="postgresql://postgres:[TU_PASSWORD]@db.[TU_PROYECTO].supabase.co:5432/postgres"

# --- Redis (local o Upstash/Redis cloud) ---
REDIS_URL="redis://localhost:6379"

# --- API NestJS ---
API_PORT=3000
# Orígenes permitidos (CORS) separados por comas
WEB_ORIGIN="http://localhost:5173,http://localhost:4173"
# Saltos de proxy inverso (X-Forwarded-For) en los que confía Express para
# leer la IP real del cliente y aplicar el rate limit por IP.
# En local basta el valor por defecto (1). En producción la petición recorre
# Vercel (edge) -> Render (app), es decir 2 saltos, por eso allí hace falta:
# TRUST_PROXY_HOPS=2

# --- Autenticación ---
# Supabase > Project Settings > API > JWT Secret (valida los access tokens de Supabase Auth)
SUPABASE_JWT_SECRET=""
# Fallback solo para desarrollo local sin Supabase
JWT_SECRET="dev-secret-cambiar-en-produccion"
# Audiencia (aud) que exige el guard al verificar el token: por defecto la de
# Supabase Auth ("authenticated"); solo hay que definirla si cambia.
# SUPABASE_JWT_AUDIENCE="authenticated"

# --- Supabase (lectura desde la web) ---
# Supabase > Project Settings > API > Project URL y anon public key
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Web Push (VAPID) ---
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-email@ejemplo.com"

# --- Email de alertas (SMTP, opcional) ---
# Sin SMTP_HOST y/o SMTP_PASS el worker NO envía ningún email: se omite con un
# aviso debug y los avisos siguen saliendo por push. Nunca rompe el sondeo.
# Gmail: smtp.gmail.com,465, usuario gmail, contraseña de aplicación
# Resend: smtp.resend.com,465, resend, re_...; requiere remitente verificado en Resend
# Puerto 465 = TLS implícito (smtps); cualquier otro (p. ej. 587) = STARTTLS
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Remitente: debe coincidir con un remitente verificado del proveedor
EMAIL_DESDE="no-reply@mantirenfe.vercel.app"

# --- Fuentes de datos de trenes ---
# Fuente de disponibilidad de asientos: mock | dwr (scraping de venta.renfe.com; fragil)
# Disponibilidad de asientos: "dwr" = venta real de Renfe (es lo que usa producción
# por defecto), "mock" = datos de prueba para desarrollo
FUENTE_DISPONIBILIDAD="mock"
# mock = datos de ejemplo (desarrollo) | dwr = API interna de venta Renfe (experimental, frágil)
# Las alertas con criterio RETRASO siempre usan GTFS-RT real (ignoran esta variable)
# Feeds GTFS-RT separados por comma (posiciones en tiempo real)
GTFS_RT_URLS="https://gtfsrt.renfe.com/vehicle_positions.json,https://gtfsrt.renfe.com/vehicle_positions_LD.json"
# Retrasos GTFS-RT (trip updates) — lo usan la API y las alertas con criterio RETRASO
GTFS_RT_TRIP_UPDATES_URL="https://gtfsrt.renfe.com/trip_updates.json,https://gtfsrt.renfe.com/trip_updates_LD.json"
# Incidencias y avisos GTFS-RT (alerts.pb, proto, se actualiza cada 20 s)
GTFS_RT_ALERTS_URL="https://gtfsrt.renfe.com/alerts.pb"
# Feeds GTFS estáticos zip (stops/trips/stop_times/calendar)
GTFS_ZIP_URLS="https://ssl.renfe.com/gtransit/Fichero_AV_LD/google_transit.zip,https://ssl.renfe.com/ftransit/Fichero_CER_FOMENTO/fomento_transit.zip"
# Días a materializar en horarioTren (hoy + N días)
GTFS_DIAS_VENTANA="45"
# --- Comparador multioperador (opcional) ---
# GTFS estático de OUIGO España desde el Punto de Acceso Nacional (NAP) del
# Ministerio. Vacío (o sin definir) = NO se importa ningún tren de OUIGO.
# URL oficial estable del fichero GTFS de Ouigo (id 1766):
GTFS_ZIP_URLS_OUIGO="https://nap.transportes.gob.es/api/Fichero/download/1766"
# El NAP exige una ApiKey en la cabecera "ApiKey": alta gratuita e instantánea en
# nap.transportes.gob.es > Editar Perfil > nombre de aplicación. Sin esta clave
# el feed se omite con un aviso (el resto de feeds siguen funcionando).
# Licencia LDA del MITRAMS (nap.transportes.gob.es/licencia-datos): obliga a citar
# "Powered by MITRAMS" (https://www.transportes.gob.es) en la web/app.
# iryo no publica GTFS: no hay nada que configurar para Iryo.
NAP_API_KEY=""
# Umbral de retraso para avisos (segundos)
RETRASO_UMBRAL_SEG="300"

# --- Observabilidad ---
# API (Nest): si está vacío, Sentry NO se inicializa (la app arranca igual)
SENTRY_DSN=""
# Web (Vite): idem, solo se carga @sentry/react si hay DSN (bundle sin él si no)
VITE_SENTRY_DSN=""

# --- Monitoreo de salud del worker ---
# GET /api/health (siempre HTTP 200) añade:
#   ultimoSondeoGlobal            -> Alerta.ultimoSondeoEn más reciente (ISO)
#   alertas.{activas,ultimoSondeoEn,retrasoMinutos}
#   umbralRetrasoMinutos = 120
# Monitor gratis sugerido: UptimeRobot (HTTP(S), 5 min, "200 OK") sobre
# https://<tu-dominio>/api/health para el uptime base, + un aviso con umbral
# alertas.retrasoMinutos > 120 (worker >2 h sin sondear con alertas activas):
#   - BetterStack (plan free): assertion JSON path $.alertas.retrasoMinutos "is
#     less than" 120 -> alerta si el valor es mayor o si viene null.
#   - UptimeRobot: keyword monitoring, alerta si el cuerpo contiene
#     "retrasoMinutos":null (alertas activas sin ningún sondeo registrado).

# --- Mobile (Expo) — EXPO_PUBLIC_* se expone al bundle del cliente ---
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
# Segundos de cach� compartida por ruta+fecha para la fuente DWR (evita repetir consultas a Renfe)
DWR_CACHE_SEG="120"

# Rol restringido (solo DML) que usa la app en runtime. Migraciones (prisma db push) usan DATABASE_URL (postgres).
# Forma del pooler Supabase para roles custom: usuario = <rol>.<project-ref>
# DATABASE_URL_APP="postgresql://mantirenfe_app.<project-ref>:<password>@<pooler>:5432/postgres"
# Segundos de cach� de posiciones GTFS-RT en la API (el feed se actualiza cada 15-30 s)
POSICIONES_CACHE_SEG="30"
# URL del proyecto Supabase (la API la usa para verificar tokens via JWKS)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"

# --- Monetizacion (fase 0, opcional) ---
# Bloques de afiliacion y donaciones de la web (apps/web). Si una variable esta
# vacia o no existe, su bloque NO se pinta (sin placeholders). En Vercel: Project
# Settings > Environment Variables, mismas claves con prefijo VITE_.
# Enlaces de afiliacion (URL de seguimiento del programa al que te des de alta)
VITE_AFF_TRAINLINE_URL=""
VITE_AFF_OMIO_URL=""
VITE_AFF_TRAVELPAYOUTS_URL=""
# Donaciones (Buy Me a Coffee u otro) - boton "Apoya el proyecto" en el footer
VITE_DONACIONES_URL=""

# Google AdSense (web) - vacio = sin anuncios; ambas vars obligatorias para pintar
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
