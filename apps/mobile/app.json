{
  "expo": {
    "name": "MantiRenfe",
    "slug": "mantirenfe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mantirenfe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mantirenfe.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#75258c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mantirenfe.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "color": "#75258c",
          "defaultChannel": "default"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#75258c"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ProximoTren",
              "label": "Próximo tren",
              "description": "La próxima salida de tus alertas activas",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ProximoTrenMini",
              "label": "Próximo tren (mini)",
              "description": "La próxima salida de tus alertas, en formato compacto",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "none",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d1d0127-ac67-4b9c-81e4-ccbd2d5b991c"
      }
    },
    "owner": "jorgemantinan",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6d1d0127-ac67-4b9c-81e4-ccbd2d5b991c"
    }
  }
}
