{
  "expo": {
    "name": "MantiRenfe",
    "slug": "mantirenfe",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mantirenfe",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mantirenfe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#75258c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mantirenfe.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      ["expo-notifications", { "color": "#75258c", "defaultChannel": "default" }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
