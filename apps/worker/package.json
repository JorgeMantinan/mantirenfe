{
  "name": "@mantirenfe/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:backfill-tripids": "tsx scripts/backfill-tripids.ts"
  },
  "dependencies": {
    "@mantirenfe/database": "workspace:*",
    "@mantirenfe/shared-types": "workspace:*",
    "adm-zip": "^0.5.16",
    "bullmq": "^5.0.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.4.0",
    "json5": "^2.2.3",
    "nodemailer": "^10.0.11",
    "pino": "^9.0.0",
    "unzipper": "^0.12.5",
    "web-push": "^3.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/unzipper": "^0.10.11",
    "@types/web-push": "^3.6.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^12.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
