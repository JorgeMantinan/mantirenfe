{
  "name": "@mantirenfe/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && pnpm prerender",
    "prerender": "vite build --config vite.prerender.config.ts && node .prerender/prerender.js",
    "preview": "vite preview --host",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "clean": "rm -rf dist .prerender"
  },
  "dependencies": {
    "@mantirenfe/shared-types": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@sentry/react": "^11.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "i18next": "^26.5.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.0",
    "workbox-precaching": "^7.1.0",
    "workbox-window": "^7.1.0"
  }
}
