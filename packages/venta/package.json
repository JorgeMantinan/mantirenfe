{
  "name": "@mantirenfe/venta",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src && prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mantirenfe/database": "workspace:*",
    "@mantirenfe/shared-types": "workspace:*",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
