generator client {
  provider        = "prisma-client-js"
  // debian-openssl-3.0.x: el engine por defecto (1.1.x) no carga en Debian 12
  // (node:*-slim) porque solo trae OpenSSL 3. "native" cubre el desarrollo local.
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProveedorAuth {
  EMAIL
  GOOGLE
  MICROSOFT
  ANONIMO
}

enum EstadoAlerta {
  ACTIVA
  PAUSA
  COMPLETADA
}

enum CriterioAlerta {
  DISPONIBILIDAD
  HORARIO
  RETRASO
  APERTURA_VENTA
  PRECIO
}

enum PlataformaPush {
  WEB
  ANDROID
  IOS
}

model Usuario {
  id             String           @id
  email          String           @unique
  nombre         String?
  avatarUrl      String?
  proveedor      ProveedorAuth    @default(EMAIL)
  preferencias   Json             @default("{}")
  creadoEn       DateTime         @default(now())
  actualizadoEn  DateTime         @updatedAt
  alertas        Alerta[]
  notificaciones Notificacion[]
  suscripciones  SuscripcionPush[]
  tokensMovil    TokenPushMovil[]
}

model Estacion {
  id              String   @id
  codigo          String   @unique
  nombre          String
  ciudad          String?
  latitud         Float?
  longitud        Float?
  creadaEn        DateTime @default(now())
  alertasOrigen   Alerta[] @relation("AlertaOrigen")
  alertasDestino  Alerta[] @relation("AlertaDestino")
  horariosSalida  HorarioTren[] @relation("HorarioOrigen")
  horariosLlegada HorarioTren[] @relation("HorarioDestino")
  paradas         ParadaHorario[]
}

model Alerta {
  id                String         @id @default(cuid())
  usuarioId         String
  origenNombre      String
  destinoNombre     String
  origenEstacionId  String?
  destinoEstacionId String?
  fechaViaje        DateTime       @db.Date
  // "Cualquier fecha en los próximos 6 meses": en vez de anclarse a fechaViaje,
  // el worker rota entre fechas del rango [fechaDesde, fechaHasta] (defaults:
  // hoy y hoy + 180 días) hasta que encuentra billetes. Ignorado si no es
  // flexible. `estadoFlexible` guarda la rotación y la disponibilidad por fecha.
  fechaFlexible     Boolean        @default(false)
  fechaDesde        DateTime?      @db.Date
  fechaHasta        DateTime?      @db.Date
  estadoFlexible    Json?
  // Trayecto cotidiano: la alerta no caduca ni se completa, se re-sondea cada
  // día. `diasSemana` es el formato canónico de los días aplicables (0=domingo
  // … 6=sábado, igual que Date#getUTCDay); vacío = todos los días. Solo tiene
  // sentido con recurrente = true.
  recurrente        Boolean        @default(false)
  diasSemana        Int[]          @default([])
  // LEGACY: se conserva por compatibilidad con datos/clients antiguos y se
  // re-espeja al guardar (= diasSemana es [1,2,3,4,5]); ya no se lee.
  soloLaborables    Boolean        @default(false)
  horaDesde         String?
  horaHasta         String?
  numeroTren        String?
  criterio          CriterioAlerta @default(DISPONIBILIDAD)
  // Lista de criterios vigilados (varios avisos por alerta). Vacío = legado:
  // se usa `criterio` (que siempre guarda el primero de la lista).
  criterios         String[]       @default([])
  // Permitir1 escala si no hay directo con plazas (solo criterio DISPONIBILIDAD).
  conexiones        Boolean        @default(false)
  // Solo con criterio = PRECIO: umbral en € del aviso "avísame si baja de X".
  // En el resto de criterios se guarda null y se ignora.
  precioObjetivo    Float?
  estado            EstadoAlerta   @default(ACTIVA)
  // Agrupación ida/vuelta: id de la alerta de IDA (ancla del grupo). Null en
  // las alertas sueltas y en la propia ida; la vuelta apunta a la ida. La
  // pausa/borrado desde la tarjeta conjunta se aplica al ancla y la API lo
  // extiende a la vuelta.
  grupoId           String?
  intervaloSondeoMin Int           @default(10)
  bono              String         @default("GENERAL")
  notas             String?
  ultimoEstado      Json?
  ultimoSondeoEn    DateTime?
  recordatorioEnviadoEn DateTime?
  recordatorioTrenesEnviados String[] @default([])
  // Incidencias GTFS-RT ya avisadas a esta alerta (ids). Nunca se limpian: si
  // una incidencia se desactiva y más tarde vuelve a activarse, no se reavisa
  incidenciasNotificadas String[] @default([])
  resumenEnviadoEn  DateTime?
  creadaEn          DateTime       @default(now())
  actualizadoEn     DateTime       @updatedAt
  usuario           Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  origen            Estacion?      @relation("AlertaOrigen", fields: [origenEstacionId], references: [id])
  destino           Estacion?      @relation("AlertaDestino", fields: [destinoEstacionId], references: [id])
  notificaciones    Notificacion[]
  precios           PrecioTren[]

  @@index([usuarioId, estado])
  @@index([estado, ultimoSondeoEn])
  // Listado propio del usuario ordenado por creación (con take) y barridos por
  // fecha de viaje: sin estos, se barre y ordena toda la tabla del usuario.
  @@index([usuarioId, creadaEn])
  @@index([fechaViaje])
  // Pareja de la ida/vuelta: buscar la vuelta de un ancla (y al revés).
  @@index([grupoId])
}

// Historial de precios de disponibilidad por alerta: el worker solo inserta un
// punto cuando el precioMin o la disponibilidad de un tren cambia (o en el
// primer sondeo), y poda lo anterior a 45 días. Alimenta la gráfica
// "¿compro ahora o espero?" del detalle en web.
model PrecioTren {
  id           String   @id @default(cuid())
  alertaId     String
  numeroTren   String
  salida       String
  precioMin    Float?
  disponible   Boolean
  registradoEn DateTime @default(now())
  alerta       Alerta   @relation(fields: [alertaId], references: [id], onDelete: Cascade)

  @@index([alertaId, registradoEn])
}

model Notificacion {
  id         String    @id @default(cuid())
  usuarioId  String
  alertaId   String?
  titulo     String
  cuerpo     String
  datos      Json?
  leida      Boolean   @default(false)
  creadaEn   DateTime  @default(now())
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  alerta     Alerta?   @relation(fields: [alertaId], references: [id], onDelete: SetNull)

  @@index([usuarioId, leida, creadaEn])
  // Digests y dedupes filtran solo por fecha; el DELETE de alerta toca el FK.
  @@index([creadaEn])
  @@index([alertaId])
}

model SuscripcionPush {
  id         String          @id @default(cuid())
  usuarioId  String
  endpoint   String          @unique
  p256dh     String
  auth       String
  plataforma PlataformaPush  @default(WEB)
  activa     Boolean         @default(true)
  creadaEn   DateTime        @default(now())
  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, activa])
}

model TokenPushMovil {
  id         String          @id @default(cuid())
  usuarioId  String
  token      String          @unique
  plataforma PlataformaPush  @default(ANDROID)
  activa     Boolean         @default(true)
  creadaEn   DateTime        @default(now())
  usuario    Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, activa])
}

model HorarioTren {
  id              String   @id @default(cuid())
  numeroTren      String
  fecha           DateTime @db.Date
  salida          DateTime
  llegada         DateTime
  operador        String?
  // Trip GTFS que originó esta fila (1 fila por trip + fecha). Solo extremos:
  // sirve para cruzar con ParadaHorario y saber qué viajes operan cada día.
  tripId          String?
  origenEstacionId String
  destinoEstacionId String
  origen          Estacion @relation("HorarioOrigen", fields: [origenEstacionId], references: [id], onDelete: Cascade)
  destino         Estacion @relation("HorarioDestino", fields: [destinoEstacionId], references: [id], onDelete: Cascade)

  @@unique([numeroTren, fecha, origenEstacionId, salida])
  @@index([fecha, origenEstacionId])
}

// Paradas intermedias de cada trip del feed GTFS, SIN fecha: una fila por
// (trip, stop_sequence) del stop_times.txt. Es el modelo GTFS canónico
// (~1.66M filas fijas para AV/LD + CER) frente a materializar trayecto ×
// fecha (~2.9M, descartado por cuota). Los días de servicio no se guardan
// aquí: se resuelven cruzando tripId con HorarioTren.fecha.
//
// llegadaMin/salidaMin son minutos desde medianoche del día de servicio GTFS
// (pueden superar 1440 en servicios que acaban tras la medianoche). No son
// Date porque una parada sin fecha no tiene instante propio: el Date real se
// calcula en la query como fecha del viaje + minutos.
model ParadaHorario {
  tripId     String
  orden      Int
  estacionId String
  llegadaMin Int?
  salidaMin  Int?
  estacion   Estacion @relation(fields: [estacionId], references: [id], onDelete: Cascade)

  // PK compuesta (sin id: ahorra una columna y su índice en 1.66M filas).
  // gtfs: (trip_id, stop_sequence) es único por especificación. Medido en los
  // feeds: AV/LD y CER no comparten ningún trip_id (0 solapes de 7.148+114.348).
  @@id([tripId, orden])
  // Origen de la query de horarios: paradas de una estación en viajes concretos
  // (el filtro estacionId + tripId IN (...) necesita los dos; solo estacionId
  // dejaba el cruce en memoria sobre decenas de miles de paradas).
  @@index([estacionId, tripId])
}

model PosicionTren {
  id           String   @id
  numeroTren   String?
  latitud      Float
  longitud     Float
  velocidadKmh Float?
  retrasoSeg   Int?
  actualizadaEn DateTime @default(now())

  @@index([actualizadaEn])
}

model PosicionHistorial {
  id         String   @id @default(cuid())
  vehiculoId String
  tripId     String?
  numeroTren String?
  latitud    Float
  longitud   Float
  retrasoSeg Int?
  en         DateTime @default(now())

  @@index([vehiculoId, en])
  @@index([vehiculoId, tripId, en])
  @@index([en])
}

// Incidencias de servicio en vivo (GTFS-RT alerts de Renfe, feed alerts.pb)
model Incidencia {
  id                  String   @id
  titulo              String?
  mensaje             String?
  causa               String?
  estacionesAfectadas String[]
  desde               DateTime?
  hasta               DateTime?
  activa              Boolean  @default(true)
  actualizadaEn       DateTime @default(now())

  @@index([activa])
}

// Trenes suprimidos detectados en el feed GTFS-RT (trip updates con
// scheduleRelationship CANCELED). El feed no publica la fecha de servicio del
// viaje, así que `fecha` es el día PENINSULAR en que se detectó: un trip puede
// cancelarse hoy y operar mañana (misma tripId, distinta fecha).
//
// Sin FK a HorarioTren: el trip puede no estar en el horario (número null) y la
// fila debe sobrevivir a re-sincronizaciones del GTFS estático.
//
// Semántica: si el trip deja de aparecer CANCELED en el feed, la fila se
// MANTIENE (la cancelación fue real; el feed solo refleja el estado "ahora").
// La única limpieza es la poda por antigüedad (>7 días) del worker.
model Cancelacion {
  id          String   @id @default(cuid())
  tripId      String
  fecha       DateTime @db.Date
  numeroTren  String?
  detectadaEn DateTime @default(now())

  @@unique([tripId, fecha])
  @@index([fecha])
}

model ImpuntualidadTren {
  id            String   @id @default(cuid())
  tripId        String
  vehiculoId    String
  numeroTren    String?
  fecha         DateTime @db.Date
  retrasoMaxSeg Int
  creadoEn      DateTime @default(now())

  @@unique([tripId, fecha])
  @@index([fecha])
}
