{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo build --filter=@mantirenfe/web",
  "outputDirectory": "apps/web/dist",
  "env": {
    "COREPACK_ENABLE_DOWNLOAD_PROMPT": "0"
  },
  "github": {
    "autoJobCancelation": true
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mantirenfe.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
