# Vercel y CI instalan SIEMPRE desde el lockfile: si la caché de build
# restaura un node_modules descolocado, pnpm falla de forma explícita en vez
# de "reparar" resolviendo peers a última hora (de ahí salió un typescript@7
# que rompía rollup-plugin-dts en el build de shared-types).
frozen-lockfile=true
