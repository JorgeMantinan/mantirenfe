{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "API_PORT",
    "WEB_ORIGIN",
    "SUPABASE_JWT_SECRET",
    "JWT_SECRET",
    "SENTRY_DSN",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "FUENTE_DISPONIBILIDAD",
    "GTFS_RT_URLS",
    "GTFS_ZIP_URLS",
    "GTFS_ZIP_URLS_OUIGO",
    "NAP_API_KEY",
    "GTFS_DIAS_VENTANA",
    "RETRASO_UMBRAL_SEG",
    "VITE_SUPABASE_URL",
    "VITE_SUPABASE_ANON_KEY",
    "VITE_API_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_SUPABASE_URL",
    "EXPO_PUBLIC_SUPABASE_ANON_KEY"
  ],
  "globalPassThroughEnv": ["CI", "GITHUB_*"]
}
